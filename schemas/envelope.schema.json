{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/envelope.schema.json",
  "title": "Contract envelope (success or error)",
  "$defs": {
    "contract": {
      "type": "string",
      "pattern": "^1\\.\\d+$",
      "description": "semver major.minor; major 1 accepted, minor only adds fields"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "contract",
        "tool",
        "data"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "contract",
        "tool",
        "error"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "data"
        ]
      },
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
