{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/next-story.schema.json",
  "title": "next_step.py <ID> --json",
  "type": "object",
  "required": [
    "contract",
    "tool",
    "data"
  ],
  "additionalProperties": true,
  "properties": {
    "contract": {
      "$ref": "envelope.schema.json#/$defs/contract"
    },
    "tool": {
      "const": "next-story"
    },
    "data": {
      "type": "object",
      "required": [
        "step",
        "ids",
        "why",
        "owner",
        "deps",
        "deps_done"
      ],
      "properties": {
        "step": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "deps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deps_done": {}
      },
      "additionalProperties": true
    }
  }
}
