{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/check.schema.json",
  "title": "check_workflow.py --json",
  "type": "object",
  "required": [
    "contract",
    "tool",
    "data"
  ],
  "additionalProperties": true,
  "properties": {
    "contract": {
      "$ref": "envelope.schema.json#/$defs/contract"
    },
    "tool": {
      "const": "check"
    },
    "data": {
      "type": "object",
      "required": [
        "ok",
        "errors",
        "warnings",
        "counts",
        "issues"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "area",
              "message"
            ],
            "properties": {
              "level": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "area": {
                "enum": [
                  "inception",
                  "backlog",
                  "chain",
                  "adapters"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
